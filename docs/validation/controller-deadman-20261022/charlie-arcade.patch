index 0000000..2b4786d
--- /dev/null
+++ b/src/controller_lease.py
@@ -0,0 +1,87 @@
+"""Independent server-side deadman; no socket or game-state dependency."""
+import logging
+import threading
+import time
+
+
+class ControllerLease:
+    SECONDS = 1.0
+    PERIOD = 0.025
+
+    def __init__(self, controller, clock=time.monotonic):
+        self.controller = controller
+        self.clock = clock
+        self.lock = threading.RLock()
+        self.owner = None
+        self.deadline = 0.0
+        self.expired = set()
+        self.failed = False
+        self.stop = threading.Event()
+        self.thread = None
+
+    def start(self):
+        self.thread = threading.Thread(target=self._watch, name='controller-deadman', daemon=True)
+        self.thread.start()
+
+    def _watch(self):
+        while not self.stop.wait(self.PERIOD):
+            try:
+                self.poll()
+            except Exception:
+                logging.exception('Controller neutral release failed; commands inhibited; retrying')
+
+    def _neutral(self):
+        try:
+            self.controller.neutral()
+        except Exception:
+            self.failed = True
+            raise
+        self.owner = None
+        self.deadline = 0.0
+
+    def poll(self):
+        with self.lock:
+            if self.failed or (self.owner is not None and self.clock() >= self.deadline):
+                if self.owner is not None:
+                    self.expired.add(self.owner)
+                self._neutral()
+
+    def command(self, session, command):
+        with self.lock:
+            self.poll()
+            if self.failed or session in self.expired:
+                return False
+            if self.owner is not None and self.owner is not session:
+                return False
+            # LEASE acquires/renews without changing held state. Legacy accepted
+            # controller commands also renew, but arbitrary traffic cannot.
+            began = self.clock()
+            if command != 'LEASE':
+                try:
+                    self.controller.command(command)
+                except ValueError:
+                    return False
+                except Exception:
+                    self.expired.add(session)
+                    self._neutral()
+                    raise
+            self.owner = session
+            self.deadline = began + self.SECONDS
+            return True
+
+    def neutral(self):
+        # Any client/operator may release globally; never requires ownership.
+        with self.lock:
+            self._neutral()
+
+    def disconnect(self, session):
+        with self.lock:
+            if self.owner is session:
+                self._neutral()
+            self.expired.discard(session)
+
+    def close(self):
+        self.stop.set()
+        if self.thread:
+            self.thread.join(timeout=2)
+        self.neutral()
