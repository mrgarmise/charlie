diff --git a/tests/test_controller_lease.py b/tests/test_controller_lease.py
new file mode 100644
index 0000000..c1f104e
--- /dev/null
+++ b/tests/test_controller_lease.py
@@ -0,0 +1,219 @@
+"""Real controller event generation and launcher workers, without /dev/uinput."""
+import os
+from pathlib import Path
+import signal
+import socket
+import subprocess
+import sys
+import threading
+import time
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'src'))
+import launcher
+from controller import CharlieController, BUTTONS, EV_ABS, EV_KEY
+from controller_lease import ControllerLease
+
+
+class RecordingController(CharlieController):
+    def __init__(self):
+        super().__init__()
+        self.events = []
+
+    def _emit(self, kind, code, value):
+        self.events.append((kind, code, value))
+
+
+class LeaseTests(unittest.TestCase):
+    def setUp(self):
+        self.c = RecordingController()
+        self.now = 10.0
+        self.lease = ControllerLease(self.c, lambda: self.now)
+        self.a, self.b = object(), object()
+
+    def test_legacy_commands_and_exact_deadline(self):
+        for command in ('LS_UP_RIGHT', 'RS_LEFT', 'A_DOWN', 'LT_DOWN'):
+            self.assertTrue(self.lease.command(self.a, command))
+        self.now += .999
+        self.lease.poll()
+        self.assertTrue(self.c.held['A'])
+        self.now += .001
+        self.lease.poll()
+        self.assertFalse(any(self.c.held.values()))
+        values = {(k, code): value for k, code, value in self.c.events}
+        self.assertTrue(all(v == 0 for (k, _), v in values.items() if k in (EV_ABS, EV_KEY)))
+        self.assertEqual(sum(k == EV_KEY for k, _ in values), len(BUTTONS))
+
+    def test_explicit_renewal_preserves_controls_without_neutral(self):
+        self.lease.command(self.a, 'LS_RIGHT')
+        count = len(self.c.events)
+        for _ in range(20):
+            self.now += .4
+            self.assertTrue(self.lease.command(self.a, 'LEASE'))
+            self.lease.poll()
+            self.assertTrue(self.c.held['LS_RIGHT'])
+        self.assertEqual(len(self.c.events), count)
+
+    def test_invalid_traffic_does_not_renew_and_expiry_requires_reconnect(self):
+        self.lease.command(self.a, 'A_DOWN')
+        self.now += .9
+        self.assertFalse(self.lease.command(self.a, 'INVALID'))
+        self.now += .11
+        self.assertFalse(self.lease.command(self.a, 'LEASE'))
+        self.assertFalse(self.lease.command(self.a, 'A_DOWN'))
+        self.assertFalse(any(self.c.held.values()))
+        self.assertTrue(self.lease.command(self.b, 'LEASE'))
+
+    def test_concurrent_clients_cannot_renew_change_or_disconnect_owner(self):
+        self.lease.command(self.a, 'A_DOWN')
+        self.assertFalse(self.lease.command(self.b, 'LEASE'))
+        self.assertFalse(self.lease.command(self.b, 'LS_RIGHT'))
+        self.lease.disconnect(self.b)
+        self.assertTrue(self.c.held['A'])
+        self.lease.disconnect(self.a)
+        self.assertFalse(any(self.c.held.values()))
+        self.assertTrue(self.lease.command(self.b, 'LS_LEFT'))
+
+    def test_any_client_neutral_is_safe_and_repeated(self):
+        self.lease.command(self.a, 'A_DOWN')
+        self.lease.neutral()
+        self.lease.neutral()
+        self.assertFalse(any(self.c.held.values()))
+        self.assertTrue(self.lease.command(self.b, 'LEASE'))
+
+    def test_simultaneous_claims_have_exactly_one_owner(self):
+        barrier = threading.Barrier(3)
+        results = []
+        def claim(session):
+            barrier.wait()
+            results.append((session, self.lease.command(session, 'A_DOWN')))
+        threads = [threading.Thread(target=claim, args=(s,)) for s in (self.a, self.b)]
+        for t in threads:
+            t.start()
+        barrier.wait()
+        for t in threads:
+            t.join(2)
+        self.assertEqual(sum(ok for _, ok in results), 1)
+        self.assertIs(self.lease.owner, next(s for s, ok in results if ok))
+
+    def test_tap_keeps_normal_timing(self):
+        began = time.monotonic()
+        self.assertTrue(self.lease.command(self.a, 'A'))
+        self.assertGreaterEqual(time.monotonic() - began, .09)
+        self.assertFalse(self.c.held['A'])
+
+    def test_neutral_failure_inhibits_commands_and_retries(self):
+        self.lease.command(self.a, 'A_DOWN')
+        neutral = self.c.neutral
+        self.c.neutral = lambda: (_ for _ in ()).throw(OSError('write failed'))
+        self.now += 2
+        with self.assertRaises(OSError):
+            self.lease.poll()
+        self.c.neutral = neutral
+        self.lease.poll()
+        self.assertFalse(self.lease.command(self.b, 'A_DOWN'))
+        self.assertFalse(any(self.c.held.values()))
+
+
+class WorkerTests(unittest.TestCase):
+    def setUp(self):
+        self.c = RecordingController()
+        self.old = launcher.charlie_controller, launcher.controller_lease, launcher.player_mode
+        launcher.charlie_controller = self.c
+        self.lease = launcher.controller_lease = ControllerLease(self.c)
+        launcher.player_mode = 'CHARLIE'
+        self.lease.start()
+        self.clients = []
+        self.workers = []
+
+    def connect(self):
+        client, server = socket.socketpair()
+        client.settimeout(3)
+        worker = threading.Thread(target=launcher.network_connection_worker, args=(server,), daemon=True)
+        worker.start()
+        self.clients.append(client)
+        self.workers.append(worker)
+        return client
+
+    def send(self, client, command):
+        client.sendall(command.encode() + b'\n')
+        return client.recv(64)
+
+    def wait_neutral(self):
+        deadline = time.monotonic() + 1.4
+        while any(self.c.held.values()) and time.monotonic() < deadline:
+            time.sleep(.005)
+        self.assertFalse(any(self.c.held.values()))
+
+    def tearDown(self):
+        for c in self.clients:
+            c.close()
+        for w in self.workers:
+            w.join(2)
+        self.lease.close()
+        launcher.charlie_controller, launcher.controller_lease, launcher.player_mode = self.old
+
+    def test_stalled_open_socket_and_partial_line_release(self):
+        client = self.connect()
+        self.assertEqual(self.send(client, 'LS_RIGHT'), b'OK\n')
+        client.sendall(b'LEA')
+        self.wait_neutral()
+        client.sendall(b'SE\n')
+        self.assertEqual(client.recv(64), b'ERROR\n')
+
+    def test_worker_disconnect_and_nonowner_disconnect(self):
+        a, b = self.connect(), self.connect()
+        self.assertEqual(self.send(a, 'A_DOWN'), b'OK\n')
+        self.assertEqual(self.send(b, 'LEASE'), b'ERROR\n')
+        b.close()
+        self.workers[1].join(2)
+        self.assertTrue(self.c.held['A'])
+        a.close()
+        self.workers[0].join(2)
+        self.assertFalse(any(self.c.held.values()))
+
+    def test_worker_renewal_then_neutral_from_other_client(self):
+        a, b = self.connect(), self.connect()
+        self.assertEqual(self.send(a, 'RS_UP'), b'OK\n')
+        for _ in range(4):
+            time.sleep(.3)
+            self.assertEqual(self.send(a, 'LEASE'), b'OK\n')
+            self.assertTrue(self.c.held['RS_UP'])
+        self.assertEqual(self.send(b, 'NEUTRAL'), b'OK\n')
+        self.assertFalse(any(self.c.held.values()))
+
+    def test_frozen_real_charlie_client_releases_with_socket_still_open(self):
+        root = os.environ.get('CHARLIE_TEST_ROOT')
+        if not root:
+            self.skipTest('set CHARLIE_TEST_ROOT for cross-repository SIGSTOP integration')
+        client = self.connect()
+        code = '''
+import socket, sys, time
+from experiments.ppal import arcade_transport as transport
+from experiments.ppal.models import Action
+connection = socket.socket(fileno=int(sys.argv[1]))
+transport.socket.create_connection = lambda *a, **k: connection
+c = transport.ArcadeController('unused', require_lease=True, pulse=False)
+c.execute(Action('E', 'N'), 30)
+print('READY', flush=True)
+time.sleep(60)
+'''
+        child = subprocess.Popen([sys.executable, '-c', code, str(client.fileno())],
+            cwd=root, pass_fds=(client.fileno(),), stdout=subprocess.PIPE, text=True)
+        try:
+            import select
+            self.assertTrue(select.select([child.stdout], [], [], 5)[0])
+            self.assertEqual(child.stdout.readline().strip(), 'READY')
+            self.assertTrue(self.c.held['LS_RIGHT'])
+            os.kill(child.pid, signal.SIGSTOP)
+            self.wait_neutral()
+            self.assertIsNone(child.poll())
+            self.assertEqual(self.send(client, 'LEASE'), b'ERROR\n')
+        finally:
+            child.kill()
+            child.wait(timeout=3)
+            child.stdout.close()
+
+
+if __name__ == '__main__':
+    unittest.main()
